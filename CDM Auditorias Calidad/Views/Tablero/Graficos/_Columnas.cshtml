@model TableroModelo
@* «Evolución de auditorías»: columnas con el total de auditorías por día, semana o mes.
   SVG estirado al plano y textos en HTML encima. Cada periodo lleva una banda invisible con su
   <title> («Etiqueta · Serie valor · …»): site.js la convierte en la ficha al pasar el ratón. *@
@{
    var puntos = Model.Evolucion;
    var n = Math.Max(1, puntos.Count);
    var (tope, paso) = EscalaGrafico.DesdeCero(puntos.Count > 0 ? puntos.Max(p => p.Cantidad) : 0);
    double X(int i) => (i + 0.5) / n;
    double Y(double v) => 1 - v / tope;
    var ancho = Math.Min(0.085, 0.68 / n);
    var conValores = n <= 31;
    var pasoX = Math.Max(1, (int)Math.Ceiling(n / 16.0));
    string C(double fr) => Formato.Coord(fr * 1000);
    string P(double fr) => Formato.Coord(fr * 100) + "%";
    var tituloEje = Model.Vista switch { Vista.Dia => "Día", Vista.Semana => "Semana", _ => "Mes" };
}
@if (puntos.Count == 0)
{
    <p class="vacio">Sin auditorías con estos filtros</p>
}
else
{
    <figure class="grafica" role="img" aria-label="Total de auditorías por @tituloEje.ToLowerInvariant()">
        <div class="plano">
            <svg viewBox="0 0 1000 1000" preserveAspectRatio="none" aria-hidden="true">
                @for (var v = 0.0; v <= tope + paso / 2; v += paso)
                {
                    <line class="rejilla-linea" x1="0" x2="1000" y1="@C(Y(v))" y2="@C(Y(v))" vector-effect="non-scaling-stroke" />
                }
                @for (var i = 0; i < puntos.Count; i++)
                {
                    var p = puntos[i];
                    var alto = Math.Max(0.004, 1 - Y(p.Cantidad));
                    <rect class="columna" data-i="@i" x="@C(X(i) - ancho / 2)" y="@C(1 - alto)" width="@C(ancho)" height="@C(alto)" />
                }
                @for (var i = 0; i < puntos.Count; i++)
                {
                    var p = puntos[i];
                    <rect class="banda" data-i="@i" data-x="@Formato.Coord(X(i))" x="@C((double)i / n)" y="0" width="@C(1.0 / n)" height="1000"><title>@p.Detalle · Auditorías @Formato.Entero(p.Cantidad) · Nota @Formato.Porcentaje(p.Nota)</title></rect>
                }
            </svg>
            @for (var v = 0.0; v <= tope + paso / 2; v += paso)
            {
                <span class="eje-y" style="top:@P(Y(v))">@Formato.Entero((int)Math.Round(v))</span>
            }
            @for (var i = 0; i < puntos.Count; i++)
            {
                var p = puntos[i];
                if (conValores)
                {
                    <span class="valor@(n > 16 ? " pequeno" : "")" style="left:@P(X(i));top:@P(Y(p.Cantidad))">@Formato.Entero(p.Cantidad)</span>
                }
                if (i % pasoX == 0 || i == puntos.Count - 1)
                {
                    <span class="eje-x" style="left:@P(X(i))">@p.Etiqueta</span>
                }
            }
        </div>
    </figure>
    <div class="titulo-eje">@tituloEje</div>
}
