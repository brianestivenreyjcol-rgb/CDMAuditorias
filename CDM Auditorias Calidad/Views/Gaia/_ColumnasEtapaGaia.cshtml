@model (IReadOnlyList<GrupoGaia> Grupos, Func<IndicadoresGaia, double?> Valor, string Nombre, double? Media, bool PorUmbral)
@* Un indicador por etapa de formación (1 Preconexión → Aseguramiento 6), en columnas con las piezas de la
   guía (SVG estirado, textos en HTML, una banda con <title> por etapa para la ficha). Etiquetas de impacto,
   no de todas: la media del filtro (línea discontinua con su cifra a la derecha) y la etapa más alta y la
   más baja. Con PorUmbral las columnas llevan el color de la adherencia (≤ 40 %, ≤ 70 %, más). *@
@{
    var grupos = Model.Grupos;
    var n = Math.Max(1, grupos.Count);
    var valores = grupos.Select(g => Model.Valor(g.Indicadores)).ToList();
    var maxPct = valores.Where(v => v is not null).Select(v => v!.Value * 100).Append((Model.Media ?? 0) * 100).DefaultIfEmpty(0).Max();
    var (tope, paso) = EscalaGrafico.DesdeCero(maxPct, 4);
    double X(int i) => (i + 0.5) / n;
    double Y(double pct) => 1 - pct / tope;
    var ancho = Math.Min(0.08, 0.6 / n);
    var conValor = valores.Select((v, i) => (V: v, I: i)).Where(p => p.V is not null).ToList();
    var iAlto = conValor.Count > 0 ? conValor.MaxBy(p => p.V)!.I : -1;
    var iBajo = conValor.Count > 1 ? conValor.MinBy(p => p.V)!.I : -1;
    if (iBajo >= 0 && valores[iBajo] == valores[iAlto]) iBajo = -1;
}
<figure class="grafica con-meta" role="img" aria-label="@Model.Nombre por etapa de formación">
    <div class="plano">
        <svg viewBox="0 0 1000 1000" preserveAspectRatio="none" aria-hidden="true">
            @for (var v = 0.0; v <= tope + paso / 2; v += paso)
            {
                <line class="rejilla-linea" x1="0" x2="1000" y1="@C(Y(v))" y2="@C(Y(v))" vector-effect="non-scaling-stroke" />
            }
            @for (var i = 0; i < grupos.Count; i++)
            {
                if (valores[i] is not { } v) continue;
                var alto = Math.Max(0.004, 1 - Y(v * 100));
                <rect class="columna@(Model.PorUmbral ? " columna-umbral " + TonoAdherencia(v) : "")" data-i="@i" x="@C(X(i) - ancho / 2)" y="@C(1 - alto)" width="@C(ancho)" height="@C(alto)" />
            }
            @if (Model.Media is { } media)
            {
                <line class="meta" x1="0" x2="1000" y1="@C(Y(media * 100))" y2="@C(Y(media * 100))" vector-effect="non-scaling-stroke" />
            }
            @for (var i = 0; i < grupos.Count; i++)
            {
                <rect class="banda" data-i="@i" data-x="@Formato.Coord(X(i))" x="@C((double)i / n)" y="0" width="@C(1.0 / n)" height="1000"><title>@EtapaLegible(grupos[i].Texto) · @NombreFicha(Model.Nombre) @Formato.Porcentaje(valores[i]) · Llamadas @Formato.Entero(grupos[i].Indicadores.Llamadas)</title></rect>
            }
        </svg>
        @for (var v = 0.0; v <= tope + paso / 2; v += paso)
        {
            <span class="eje-y" style="top:@P(Y(v))">@Formato.PorcentajeEntero(v)</span>
        }
        @if (Model.Media is { } mt)
        {
            <span class="meta-texto" style="top:@P(Y(mt * 100))">media @Formato.Porcentaje(mt)</span>
        }
        @for (var i = 0; i < grupos.Count; i++)
        {
            if (valores[i] is not { } v) continue;
            if (i == iAlto || i == iBajo)
            {
                <span class="valor pequeno con-fondo" style="left:@P(X(i));top:@P(Y(v * 100))">@(i == iAlto ? "máx. " : "mín. ")@Formato.Porcentaje(v)</span>
            }
        }
        @for (var i = 0; i < grupos.Count; i++)
        {
            <span class="eje-x" style="left:@P(X(i))">@EtapaCorta(grupos[i].Texto)</span>
        }
    </div>
</figure>
