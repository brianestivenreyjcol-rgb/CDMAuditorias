@model IReadOnlyList<GrupoGaia>
@* Llamadas de cada día, en columnas bajas bajo la línea del indicador (misma posición horizontal). Etiqueta
   de impacto: el día con más llamadas. El eje X (fechas) va aquí; la última fecha siempre se escribe y las
   intermedias solo si no la pisan. *@
@{
    var grupos = Model;
    var n = Math.Max(1, grupos.Count);
    var maximo = grupos.Select(g => (double)g.Indicadores.Llamadas).DefaultIfEmpty(0).Max();
    var (tope, paso) = EscalaGrafico.DesdeCero(maximo, 2);
    double X(int i) => (i + 0.5) / n;
    double Y(double v) => 1 - v / tope;
    var ancho = Math.Min(0.06, 0.8 / n);
    var pasoX = Math.Max(1, (int)Math.Ceiling(n / 12.0));
    var iAlto = grupos.Count > 0 ? grupos.Select((g, i) => (g.Indicadores.Llamadas, i)).MaxBy(p => p.Llamadas).i : -1;
}
<figure class="grafica lineas-ns corta" role="img" aria-label="Llamadas por día">
    <div class="plano">
        <svg viewBox="0 0 1000 1000" preserveAspectRatio="none" aria-hidden="true">
            @for (var v = 0.0; v <= tope + paso / 2; v += paso)
            {
                <line class="rejilla-linea" x1="0" x2="1000" y1="@C(Y(v))" y2="@C(Y(v))" vector-effect="non-scaling-stroke" />
            }
            @for (var i = 0; i < grupos.Count; i++)
            {
                var llamadas = grupos[i].Indicadores.Llamadas;
                if (llamadas <= 0) continue;
                var alto = Math.Max(0.01, 1 - Y(llamadas));
                <rect class="columna columna-volumen" data-i="@i" x="@C(X(i) - ancho / 2)" y="@C(1 - alto)" width="@C(ancho)" height="@C(alto)" />
            }
            @for (var i = 0; i < grupos.Count; i++)
            {
                <rect class="banda" data-i="@i" data-x="@Formato.Coord(X(i))" x="@C((double)i / n)" y="0" width="@C(1.0 / n)" height="1000"><title>@DiaLargo(grupos[i].Clave) · Llamadas @Formato.Entero(grupos[i].Indicadores.Llamadas)</title></rect>
            }
        </svg>
        @for (var v = 0.0; v <= tope + paso / 2; v += paso)
        {
            <span class="eje-y" style="top:@P(Y(v))">@Formato.Entero((int)v)</span>
        }
        @if (iAlto >= 0)
        {
            <span class="valor pequeno con-fondo" style="left:@P(X(iAlto));top:@P(Y(grupos[iAlto].Indicadores.Llamadas))">máx. @Formato.Entero(grupos[iAlto].Indicadores.Llamadas)</span>
        }
        @for (var i = 0; i < grupos.Count; i++)
        {
            if (i == grupos.Count - 1 || (i % pasoX == 0 && grupos.Count - 1 - i >= pasoX))
            {
                <span class="eje-x" style="left:@P(X(i))">@(DateOnly.TryParse(grupos[i].Clave, out var d) ? Formato.Fecha(d) : grupos[i].Texto)</span>
            }
        }
    </div>
</figure>
