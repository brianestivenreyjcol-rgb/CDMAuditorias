@model GraficoGaia
@* Líneas por día, semana o etapa con una o varias series (porcentajes, segundos o recuentos), con las piezas de la
   guía: crono-linea y punto, y una banda con <title> por punto para la ficha. Cada punto lleva su valor en una pastilla
   (.etiqueta-punto) con el color de su serie; con dos series, la mayor encima y la menor debajo; con más de ~20 periodos
   se rotula uno de cada dos o menos (y siempre el primero y el último). Dos series con escalas muy distintas: eje
   izquierdo para la primera y derecho para la segunda. Sin eje X cuando debajo va el volumen (comparten posiciones). *@
@{
    var n = Math.Max(1, Model.Etiquetas.Count);
    var series = Model.Series;
    var doble = Doble(Model);
    var todos = series.SelectMany(s => s.Valores).Where(v => v is not null).Select(v => v!.Value)
        .Concat(Model.Referencias).Concat(Model.Media.HasValue ? new[] { Model.Media.Value } : Array.Empty<double>()).ToList();
    var escalas = doble
        ? series.Select(s => Escala(Model, s.Valores.Where(v => v is not null).Select(v => v!.Value), false)).ToArray()
        : new[] { Escala(Model, todos, false) };
    EscalaGaia Esc(int k) => escalas[doble ? k : 0];
    double X(int i) => (i + 0.5) / n;
    var conPuntos = n <= 45;
    var rotulados = Rotulados(Model);
    var pasoX = Math.Max(1, (int)Math.Ceiling(n / (double)Model.MaxEtiquetasX));

    string Trazo(int k)
    {
        var t = new System.Text.StringBuilder();
        var valores = series[k].Valores;
        for (var i = 0; i < valores.Count; i++)
        {
            if (valores[i] is not { } v) continue;
            t.Append(i > 0 && valores[i - 1] is not null ? "L" : "M").Append($"{C(X(i))},{C(Esc(k).Y(v))} ");
        }
        return t.ToString();
    }
}
@if (Model.ConLeyenda)
{
    @await Html.PartialAsync("_LeyendaGraficoGaia", Model)
}
<figure class="grafica lineas-ns@(Model.EjeX ? "" : " sin-eje-x")" role="img" aria-label="@Model.Descripcion">
    <div class="plano">
        <svg viewBox="0 0 1000 1000" preserveAspectRatio="none" aria-hidden="true">
            @foreach (var v in escalas[0].Marcas())
            {
                <line class="rejilla-linea" x1="0" x2="1000" y1="@C(escalas[0].Y(v))" y2="@C(escalas[0].Y(v))" vector-effect="non-scaling-stroke" />
            }
            @foreach (var referencia in Model.Referencias.Where(x => x >= escalas[0].Min && x <= escalas[0].Max))
            {
                <line class="meta" x1="0" x2="1000" y1="@C(escalas[0].Y(referencia))" y2="@C(escalas[0].Y(referencia))" vector-effect="non-scaling-stroke" />
            }
            @if (Model.Media is { } media)
            {
                <line class="meta" x1="0" x2="1000" y1="@C(escalas[0].Y(media))" y2="@C(escalas[0].Y(media))" vector-effect="non-scaling-stroke" />
            }
            @for (var k = 0; k < series.Count; k++)
            {
                <g class="@series[k].Clase"><path class="crono-linea" d="@Trazo(k)" vector-effect="non-scaling-stroke" /></g>
            }
            @for (var i = 0; i < Model.Etiquetas.Count; i++)
            {
                var partes = series.Select(s => $"{NombreFicha(s.Nombre)} {Valor(s.Valores[i], Model)}");
                <rect class="banda" data-i="@i" data-x="@Formato.Coord(X(i))" x="@C((double)i / n)" y="0" width="@C(1.0 / n)" height="1000"><title>@Model.Titulos[i] · @string.Join(" · ", partes) · @Model.NombreVolumen @Formato.Entero(Model.Volumen[i])</title></rect>
            }
        </svg>
        @foreach (var v in escalas[0].Marcas())
        {
            <span class="eje-y" style="top:@P(escalas[0].Y(v))">@Eje(Model, v, escalas[0])</span>
        }
        @if (doble)
        {
            foreach (var v in escalas[1].Marcas())
            {
                <span class="eje-y derecho" style="top:@P(escalas[1].Y(v))">@Eje(Model, v, escalas[1])</span>
            }
        }
        @if (conPuntos)
        {
            for (var k = 0; k < series.Count; k++)
            {
                for (var i = 0; i < series[k].Valores.Count; i++)
                {
                    if (series[k].Valores[i] is not { } v) continue;
                    <span class="punto @series[k].Clase" data-i="@i" style="left:@P(X(i));top:@P(Esc(k).Y(v))"></span>
                }
            }
        }
        @for (var k = 0; k < series.Count; k++)
        {
            for (var i = 0; i < series[k].Valores.Count; i++)
            {
                if (!rotulados.Contains(i) || series[k].Valores[i] is not { } v) continue;
                var y = Esc(k).Y(v);
                var arriba = true;
                if (series.Count == 2 && series[1 - k].Valores[i] is { } otro)
                {
                    var yOtro = Esc(1 - k).Y(otro);
                    arriba = y < yOtro || (y == yOtro && k == 0);
                }
                // Una pastilla «debajo» de un punto pegado al eje X pisaría sus fechas; una «encima» de uno pegado al techo se saldría.
                if (!arriba && y > 0.9) arriba = true;
                else if (arriba && y < 0.06 && series.Count == 2) arriba = false;
                <span class="etiqueta-punto @series[k].Clase @(arriba ? "arriba" : "abajo")" style="left:@P(X(i));top:@P(y)">@Valor(v, Model)</span>
            }
        }
        @if (Model.EjeX)
        {
            @for (var i = 0; i < Model.Etiquetas.Count; i++)
            {
                if (i == Model.Etiquetas.Count - 1 || (i % pasoX == 0 && Model.Etiquetas.Count - 1 - i >= pasoX))
                {
                    <span class="eje-x" style="left:@P(X(i))">@Model.Etiquetas[i]</span>
                }
            }
        }
    </div>
</figure>
