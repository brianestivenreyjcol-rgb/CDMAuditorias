@model (string? Titulo, IReadOnlyList<TramoGaia> Tramos, bool Leyenda)
@* Una barra al 100 % apilada (resuelto / pendiente / no se puede cumplir; sentimientos): cada tramo lleva el color de
   su tono (--relleno) y su ancho en %. Con Leyenda, debajo, cada tramo con su cifra. *@
<div class="apilada-bloque">
    @if (Model.Titulo is not null && Model.Leyenda)
    {
        <span class="apilada-titulo">@Model.Titulo</span>
    }
    <div class="apilada" role="img" aria-label="@(Model.Titulo ?? "Reparto")"
         title="@(Model.Titulo ?? "Reparto") · @string.Join(" · ", Model.Tramos.Select(t => $"{t.Nombre} {Formato.Porcentaje(t.Fraccion)}"))">
        @foreach (var t in Model.Tramos.Where(t => t.Fraccion > 0))
        {
            <span class="tramo @t.Clase" style="width:@(Formato.Coord(t.Fraccion * 100))%"></span>
        }
    </div>
    @if (Model.Leyenda)
    {
        <div class="veredicto-ns">
            @foreach (var t in Model.Tramos)
            {
                <span class="@t.Clase"><i></i>@t.Nombre <b>@Formato.Porcentaje(t.Fraccion)</b></span>
            }
        </div>
    }
</div>
