@model PaginaRankingGaia
@* Ranking: una fila por agente con todos los indicadores. El orden se pide al servidor (cabeceras con enlace,
   la activa marcada con su sentido) y el buscador filtra por nombre. Cada celda se compara con el total del
   filtro con un tinte suave (verde mejor, rojo peor, según si en ese indicador más alto es mejor); los
   agentes con pocas llamadas van en gris y sin tinte. *@
@{
    Layout = "_InformeGaia";
}
@if (!Model.Preparando)
{
    var t = Model.Total!;
    // clave y cabecera corta (el nombre completo y la ayuda salen del tooltip del indicador)
    var columnas = new (string Clave, string Texto)[]
    {
        ("adherencia", "Adherencia"), ("rellamada", "Rellamada"), ("nosolucion", "No solución"), ("transferencia", "Transf."),
        ("churn", "Churn"), ("ofrecimientos", "Ofrec."), ("ventas", "Ventas"), ("positivo", "Positivo final"), ("negativo", "Negativo final"),
    };
    string? SentidoDe(string clave) => Model.Orden == clave ? (Model.Descendente ? "descending" : "ascending") : null;

    <section class="tarjeta">
        <header class="tarjeta-cabecera">
            <h2>Ranking de agentes</h2>
            <span class="tarjeta-nota">@Formato.Entero(Model.Filas.Count) @(Model.Filas.Count == 1 ? "agente" : "agentes")@(string.IsNullOrEmpty(Model.Busqueda) ? "" : " con la búsqueda")</span>
        </header>
        <p class="nota-ns">
            Pulsa una cabecera para ordenar. Cada celda se compara con el <b>total</b> de los filtros: en
            <span class="muestra-tinte mejor-total">verde</span> si es mejor y en <span class="muestra-tinte peor-total">rojo</span>
            si es peor (en adherencia, ofrecimientos, ventas y sentimiento positivo, más alto es mejor; en el resto, más bajo).
            En gris, los agentes con menos de <b>@MinLlamadasFiable llamadas</b>: su porcentaje no es fiable.
        </p>

        <form method="get" action="@PaginaGaia.Ruta(Model.Pestana)" class="buscar-ns" role="search" data-parcial>
            @foreach (var p in (Model.Filtros?.Parametros() ?? []).Concat(Model.ParametrosPropios.Where(x => x.Key != "q")))
            {
                <input type="hidden" name="@p.Key" value="@p.Value" />
            }
            <span class="buscar-ns-campo">
                @Iconos.Svg("buscar")
                <input type="search" name="q" value="@Model.Busqueda" aria-label="Buscar agente" placeholder="Buscar agente por nombre" />
            </span>
            <button type="submit" class="boton-aplicar">Buscar</button>
            @if (!string.IsNullOrEmpty(Model.Busqueda))
            {
                <a class="enlace" href="@Model.UrlCon(("q", null))" data-parcial>Quitar búsqueda</a>
            }
        </form>

        @if (Model.Filas.Count > 0)
        {
            <div class="tabla-contenedor alta">
                <table class="ranking con-puesto tabla-ranking-gaia">
                    <colgroup>
                        <col style="width:24%" /><col style="width:7%" /><col style="width:9%" /><col style="width:8.5%" /><col style="width:8%" />
                        <col style="width:7.5%" /><col style="width:7%" /><col style="width:7.5%" /><col style="width:7%" /><col style="width:7%" /><col style="width:7.5%" />
                    </colgroup>
                    <thead>
                        <tr>
                            <th scope="col" aria-sort="@SentidoDe("agente")"><a class="ordenar" href="@Model.UrlOrden("agente")" data-parcial>Agente</a></th>
                            <th scope="col" class="num" aria-sort="@SentidoDe("llamadas")"><a class="ordenar" href="@Model.UrlOrden("llamadas")" data-parcial>Llamadas</a></th>
                            @foreach (var c in columnas)
                            {
                                var k = CalculadoraGaia.Kpi(c.Clave);
                                <th scope="col" class="num" aria-sort="@SentidoDe(c.Clave)" title="@k.Ayuda @(k.MejorAlto ? "Más alto es mejor." : "Más bajo es mejor.")">
                                    <a class="ordenar" href="@Model.UrlOrden(c.Clave)" data-parcial>@c.Texto</a>
                                </th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var fila in Model.Filas)
                        {
                            var ind = fila.Indicadores;
                            var pocas = ind.Llamadas < MinLlamadasFiable;
                            <tr class="@(pocas ? "pocas" : null)">
                                <td title="@fila.Agente · @fila.Sector · oleada @fila.Oleada">
                                    @fila.Agente
                                    <span class="sub-ns">@fila.Sector · oleada @fila.Oleada</span>
                                </td>
                                <td class="num barra-volumen" data-valor="@ind.Llamadas">@Formato.Entero(ind.Llamadas)</td>
                                @foreach (var c in columnas)
                                {
                                    var k = CalculadoraGaia.Kpi(c.Clave);
                                    <td class="num @ClaseFrenteAlTotal(k, ind, t)" data-valor="@Formato.Crudo(k.Valor(ind))">@Formato.Porcentaje(k.Valor(ind))</td>
                                }
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="total">
                            <td>TOTAL</td>
                            <td class="num">@Formato.Entero(t.Llamadas)</td>
                            @foreach (var c in columnas)
                            {
                                <td class="num">@Formato.Porcentaje(CalculadoraGaia.Kpi(c.Clave).Valor(t))</td>
                            }
                        </tr>
                    </tfoot>
                </table>
            </div>
        }
        else
        {
            <p class="vacio">
                @if (!string.IsNullOrEmpty(Model.Busqueda))
                {
                    @:Ningún agente coincide con «@Model.Busqueda».
                }
                else
                {
                    @:Ninguna llamada cumple estos filtros.
                }
            </p>
        }
    </section>
}
