@model (IReadOnlyList<GrupoGaia> Grupos, Func<IndicadoresGaia, double?> Valor, string Nombre, double? Media, double[] Referencias)
@* Un indicador por día, en una línea con las piezas de la guía (crono-linea y punto). Va sin eje X: debajo
   va _VolumenDiaGaia con las llamadas de cada día y las dos comparten posiciones. Etiquetas de impacto, no
   de cada día: la media del filtro (línea discontinua; su cifra va en la leyenda), el día más alto y el más
   bajo entre los que tienen al menos MinLlamadasFiable llamadas (un día con tres llamadas no es un máximo)
   y, a la derecha, el último valor. Las referencias (los umbrales de la adherencia) son líneas
   discontinuas sin cifra: ya se leen en el eje. *@
@{
    var grupos = Model.Grupos;
    var n = Math.Max(1, grupos.Count);
    var valores = grupos.Select(g => Model.Valor(g.Indicadores)).ToList();
    var enEscala = valores.Where(v => v is not null).Select(v => v!.Value)
        .Concat(Model.Referencias).Concat(Model.Media.HasValue ? new[] { Model.Media.Value } : Array.Empty<double>()).ToList();
    var (minimo, maximo, paso) = EscalaGrafico.Porcentaje(enEscala);
    double X(int i) => (i + 0.5) / n;
    double Y(double v) => 1 - (v - minimo) / (maximo - minimo);
    var conPuntos = n <= 45;

    var trazo = new System.Text.StringBuilder();
    for (var i = 0; i < valores.Count; i++)
    {
        if (valores[i] is not { } v) continue;
        trazo.Append(i > 0 && valores[i - 1] is not null ? "L" : "M").Append($"{C(X(i))},{C(Y(v))} ");
    }

    var fiables = valores.Select((v, i) => (V: v, I: i)).Where(p => p.V is not null && grupos[p.I].Indicadores.Llamadas >= MinLlamadasFiable).ToList();
    var iAlto = fiables.Count > 0 ? fiables.MaxBy(p => p.V)!.I : -1;
    var iBajo = fiables.Count > 1 ? fiables.MinBy(p => p.V)!.I : -1;
    if (iBajo >= 0 && valores[iBajo] == valores[iAlto]) iBajo = -1;
    var iUltimo = valores.FindLastIndex(v => v is not null);
}
<figure class="grafica lineas-ns sin-eje-x" role="img" aria-label="@Model.Nombre por día">
    <div class="plano">
        <svg viewBox="0 0 1000 1000" preserveAspectRatio="none" aria-hidden="true">
            @for (var v = minimo; v <= maximo + paso / 2; v += paso)
            {
                <line class="rejilla-linea" x1="0" x2="1000" y1="@C(Y(v))" y2="@C(Y(v))" vector-effect="non-scaling-stroke" />
            }
            @foreach (var referencia in Model.Referencias.Where(x => x >= minimo && x <= maximo))
            {
                <line class="meta" x1="0" x2="1000" y1="@C(Y(referencia))" y2="@C(Y(referencia))" vector-effect="non-scaling-stroke" />
            }
            @if (Model.Media is { } media)
            {
                <line class="meta" x1="0" x2="1000" y1="@C(Y(media))" y2="@C(Y(media))" vector-effect="non-scaling-stroke" />
            }
            <g class="serie-orange">
                <path class="crono-linea" d="@trazo" vector-effect="non-scaling-stroke" />
            </g>
            @for (var i = 0; i < grupos.Count; i++)
            {
                <rect class="banda" data-i="@i" data-x="@Formato.Coord(X(i))" x="@C((double)i / n)" y="0" width="@C(1.0 / n)" height="1000"><title>@DiaLargo(grupos[i].Clave) · @NombreFicha(Model.Nombre) @Formato.Porcentaje(valores[i]) · Llamadas @Formato.Entero(grupos[i].Indicadores.Llamadas)</title></rect>
            }
        </svg>
        @for (var v = minimo; v <= maximo + paso / 2; v += paso)
        {
            <span class="eje-y" style="top:@P(Y(v))">@Formato.PorcentajeEntero(Math.Round(v * 100))</span>
        }
        @if (conPuntos)
        {
            for (var i = 0; i < valores.Count; i++)
            {
                if (valores[i] is not { } v) continue;
                <span class="punto serie-orange" data-i="@i" style="left:@P(X(i));top:@P(Y(v))"></span>
            }
        }
        @if (iAlto >= 0)
        {
            <span class="valor pequeno con-fondo valor-serie serie-orange" style="left:@P(X(iAlto));top:@P(Y(valores[iAlto]!.Value))">máx. @Formato.Porcentaje(valores[iAlto])</span>
        }
        @if (iBajo >= 0)
        {
            <span class="valor pequeno con-fondo valor-serie serie-orange debajo" style="left:@P(X(iBajo));top:@P(Y(valores[iBajo]!.Value))">mín. @Formato.Porcentaje(valores[iBajo])</span>
        }
        @if (iUltimo >= 0)
        {
            <span class="fin-serie serie-orange" style="top:@P(Y(valores[iUltimo]!.Value))" title="Último día con dato">@Formato.Porcentaje(valores[iUltimo])</span>
        }
    </div>
</figure>
