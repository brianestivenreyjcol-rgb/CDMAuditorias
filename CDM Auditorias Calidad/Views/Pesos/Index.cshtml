@model PaginaPesos
@* #informe de «Pesos y metas por sector». Arriba, el mes (el de los datos; la carpeta es la del mes siguiente). A la izquierda,
   los filtros y «Analizar y validar», que vuelve a leer la carpeta del mes. Mientras se analiza, la página se vuelve a pedir
   sola cada 5 s y enseña por qué fichero va. Debajo: la tira, la tabla de pesos y metas (como la del Excel de Clan), las
   comprobaciones y los ficheros leídos. *@
@{
    Layout = ViewData["Parcial"] is true ? null : "_LayoutPesos";
    var volver = Context.Request.Path + Context.Request.QueryString;
    var a = Model.Analisis;
    var analizandoAqui = Model.AnalizandoEsteMes;
    var revisar = Model.Comprobaciones.Count(c => c.Correcto == false);
    var notas = Model.Comprobaciones.Count(c => c.Correcto is null);
    var noLegibles = Model.Archivos.Count(x => x.Estado is "xlsb" or "error");
    // Solo cuentan los bloques de agentes (pedido del usuario): un fichero sin ninguno es de TL, supervisor o jefe de servicio.
    int Agentes(ArchivoAnalizado x) => ExtractorPesos.HojaPrincipal(x.Bloques) is { } h ? x.Bloques.Count(b => b.Hoja == h) : 0;
    var conPesos = Model.Archivos.Count(x => x.Estado == "ok" && Agentes(x) > 0);
    var miga = Model.Mes is { } mm ? PaginaPesos.TextoMes(mm) : "Sin datos";
}
<div id="informe" data-miga="@miga" data-marca-pagina="orange" data-titulo="Pesos y metas por sector · CDM Auditorías Calidad">
    <nav class="pestanas" aria-label="Pesos y metas">
        <a class="pestana activa" href="@PaginaPesos.Ruta" data-parcial aria-current="page">Pesos y metas</a>
        @if (Model.Meses.Count > 1)
        {
            <div class="pestanas-vista" role="group" aria-label="Mes de los datos">
                @foreach (var m in Model.Meses.Take(6).Reverse())
                {
                    <a class="segmento@(m == Model.Mes ? " activo" : "")" href="@Model.UrlMes(m)" data-parcial
                       aria-current="@(m == Model.Mes ? "true" : null)" title="@PaginaPesos.TextoMes(m) · datos de @PaginaPesos.TextoDatos(m)">@PaginaPesos.TextoMesCorto(m)</a>
                }
            </div>
        }
    </nav>

    <div class="contenedor">
    @if (Model.Aviso == "ya-en-curso")
    {
        <div class="aviso aviso-info" role="status">@Iconos.Svg("reloj") <span>Ya hay un análisis en marcha: espera a que termine para lanzar otro.</span></div>
    }
    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <div class="aviso" role="alert">@Iconos.Svg("alerta") <span>@Model.Error</span></div>
    }

    @if (Model.Mes is null)
    {
        <div class="preparando-ns">
            <h2>No se encuentran los Excel de ranking</h2>
            <p>No se llega a <code>@Model.Raiz</code> o no tiene carpetas de mes con <code>01. RANKING</code>. Comprueba que la carpeta compartida está accesible desde este equipo.</p>
        </div>
    }
    else if (a is null)
    {
        <div class="preparando-ns" data-recargar-en="@(Model.Analizando ? "5" : null)" aria-live="polite">
            @if (Model.Analizando)
            {
                <div class="girando" aria-hidden="true"></div>
                <h2>Leyendo los Excel de @PaginaPesos.TextoMes(Model.Mes)</h2>
                <p>Se busca en cada sector la versión más reciente (VF, V3, V2, V1 o precierre) y se leen sus bloques de objetivos. Tarda un par de minutos; esta página se vuelve a cargar sola.</p>
                @if (Model.Progreso is not null)
                {
                    <p class="texto-tenue">Va por el @Model.Progreso.</p>
                }
            }
            else
            {
                <h2>@PaginaPesos.TextoMes(Model.Mes) no se ha analizado</h2>
                <form method="post" action="@(PaginaPesos.Ruta)/analizar">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="mes" value="@Model.Mes.Clave" />
                    <input type="hidden" name="volver" value="@volver" />
                    <button type="submit" class="boton-aplicar">Analizar y validar</button>
                </form>
            }
        </div>
    }
    else
    {
        @if (analizandoAqui)
        {
            <div class="aviso aviso-info" role="status" data-recargar-en="5">
                @Iconos.Svg("refrescar")
                <span>Volviendo a leer los Excel de @PaginaPesos.TextoMes(Model.Mes)@(Model.Progreso is null ? "" : $": va por el {Model.Progreso}"). Mientras tanto se ve el análisis anterior; la página se recarga sola.</span>
            </div>
        }
        <div class="tablero">
            <aside class="panel-filtros" aria-label="Filtros">
                <partial name="_PanelCabecera" />
                <form method="get" action="@PaginaPesos.Ruta" data-tablero-filtros>
                    @if (Model.Mes != Model.Meses.FirstOrDefault())
                    {
                        <input type="hidden" name="mes" value="@Model.Mes.Clave" />
                    }
                    @if (Model.Peticion.Ver == "revisar")
                    {
                        <input type="hidden" name="ver" value="revisar" />
                    }
                    <div class="grupo-filtros">
                        @foreach (var g in Model.Desplegables.Where(g => g.Visible))
                        {
                            <partial name="_Desplegable" model="g" />
                        }
                    </div>
                    <noscript><button type="submit" class="boton-aplicar">Aplicar filtros</button></noscript>
                </form>
                <div class="panel-pie">
                    <form method="post" action="@(PaginaPesos.Ruta)/analizar" class="acciones-filtros">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="mes" value="@Model.Mes.Clave" />
                        <input type="hidden" name="volver" value="@volver" />
                        <button type="submit" class="btn-panel primario" disabled="@Model.Analizando"
                                title="Vuelve a buscar la versión más reciente de cada Excel del mes, lee sus pesos y metas y los valida. Tarda un par de minutos.">
                            @Iconos.Svg("refrescar") @(Model.Analizando ? "Analizando…" : "Analizar y validar")
                        </button>
                        <a class="btn-panel" href="@Model.UrlCsv" title="La tabla de pesos y metas con estos filtros, en CSV para Excel">@Iconos.Svg("hoja") Descargar CSV</a>
                        <a class="btn-panel" href="@Model.UrlLimpiar" data-parcial>@Iconos.Svg("borrar-filtros") Borrar filtros</a>
                    </form>
                    <div class="estado-datos">
                        <span>@Iconos.Svg("reloj") Analizado el @Formato.FechaHora(a.Analizado)</span>
                        <span>Carpeta @Model.Mes.Carpeta</span>
                    </div>
                </div>
            </aside>
            <main class="contenido">
                <section class="resumen en-4" aria-label="Resumen del análisis">
                    <div class="resumen-dato destacada" title="Ficheros de los que se sacó al menos un bloque de objetivos, de todos los sectores encontrados">
                        <span class="resumen-icono">@Iconos.Svg("hoja")</span>
                        <span class="resumen-titulo">Sectores leídos</span>
                        <span class="resumen-cifra" data-contar="@conPesos" data-formato="entero">@Formato.Entero(conPesos)</span>
                        <span class="resumen-variacion neutra">de @Formato.Entero(Model.Archivos.Count) ficheros del mes</span>
                    </div>
                    <div class="resumen-dato">
                        <span class="resumen-icono">@Iconos.Svg("diana")</span>
                        <span class="resumen-titulo">KPI con peso</span>
                        <span class="resumen-cifra" data-contar="@Model.Filas.Count(f => f.Peso > 0)" data-formato="entero">@Formato.Entero(Model.Filas.Count(f => f.Peso > 0))</span>
                        <span class="resumen-variacion neutra">en @Formato.Entero(Model.Filas.Select(f => (f.Sector, f.Hoja)).Distinct().Count()) hojas de ranking</span>
                    </div>
                    <div class="resumen-dato">
                        <span class="resumen-icono">@Iconos.Svg("alerta")</span>
                        <span class="resumen-titulo">Para revisar</span>
                        <span class="resumen-cifra" data-contar="@revisar" data-formato="entero">@Formato.Entero(revisar)</span>
                        <span class="resumen-variacion neutra">y @Formato.Entero(notas) @(notas == 1 ? "nota" : "notas")</span>
                    </div>
                    <div class="resumen-dato" title="Ficheros que no se pudieron abrir (dañados, protegidos con contraseña…)">
                        <span class="resumen-icono">@Iconos.Svg("cerrar")</span>
                        <span class="resumen-titulo">No legibles</span>
                        <span class="resumen-cifra" data-contar="@noLegibles" data-formato="entero">@Formato.Entero(noLegibles)</span>
                        <span class="resumen-variacion neutra">ficheros que no se pudieron abrir</span>
                    </div>
                </section>

                <section class="tarjeta">
                    <header class="tarjeta-cabecera">
                        <h2>Pesos y metas · @PaginaPesos.TextoMes(Model.Mes)</h2>
                        <span class="tarjeta-nota">la hoja principal de agentes de cada sector · datos de @PaginaPesos.TextoDatos(Model.Mes) · un KPI por fila, tal como está en el bloque de objetivos · «Copiar ruta» para abrir el Excel y validar</span>
                        <div class="pestanas-vista" role="group" aria-label="Qué filas enseñar">
                            <a class="segmento@(Model.Peticion.Ver != "revisar" ? " activo" : "")" href="@Model.UrlVer(null)" data-parcial>Todo</a>
                            <a class="segmento@(Model.Peticion.Ver == "revisar" ? " activo" : "")" href="@Model.UrlVer("revisar")" data-parcial>Para revisar</a>
                        </div>
                    </header>
                    @if (Model.Filas.Count == 0)
                    {
                        <p class="vacio">Ningún KPI con estos filtros.</p>
                    }
                    else
                    {
                        <div class="tabla-contenedor alta">
                            <table class="ranking tabla-pesos">
                                <thead>
                                    <tr>
                                        <th scope="col"><button type="button" class="ordenar">Sector</button></th>
                                        <th scope="col"><button type="button" class="ordenar">Hoja</button></th>
                                        <th scope="col"><button type="button" class="ordenar">KPI</button></th>
                                        <th scope="col" class="num"><button type="button" class="ordenar">Peso</button></th>
                                        <th scope="col" class="num"><button type="button" class="ordenar">Meta 0 %</button></th>
                                        <th scope="col" class="num"><button type="button" class="ordenar">Meta 100 %</button></th>
                                        <th scope="col" class="num"><button type="button" class="ordenar">Meta 150 %</button></th>
                                        <th scope="col" class="cab-columna">Fichero</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var f in Model.Filas)
                                    {
                                        <tr>
                                            <td class="celda-nombre" data-valor="@f.Sector"><div class="nombre-fila"><span class="nombre-texto">@f.Sector</span>@if (f.Responsable.Length > 0)
                                                {
                                                    <span class="pastilla-dato" title="Responsable del Excel">@f.Responsable</span>
                                                }</div></td>
                                            <td data-valor="@f.Hoja">@f.Hoja</td>
                                            <td data-valor="@f.Kpi">@f.Kpi@if (f.ConAvisos)
                                                {
                                                    <text> </text><span class="chip chip-atencion">Revisar</span>
                                                }</td>
                                            <td class="num" data-valor="@Formato.Crudo(f.Peso)">@(f.Peso is { } pe ? Formato.Porcentaje(pe) : "sin peso")</td>
                                            <td class="num" data-valor="@Formato.Crudo(f.Meta0)">@PaginaPesos.Meta(f.Meta0, f.EnPorcentaje)</td>
                                            <td class="num" data-valor="@Formato.Crudo(f.Meta100)">@PaginaPesos.Meta(f.Meta100, f.EnPorcentaje)</td>
                                            <td class="num" data-valor="@Formato.Crudo(f.Meta150)">@PaginaPesos.Meta(f.Meta150, f.EnPorcentaje)</td>
                                            <td><button type="button" class="enlace" data-copiar="@f.Ruta" title="@f.Ruta">@Iconos.Svg("copiar") Copiar ruta</button></td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr class="total">
                                        <td>TOTAL</td>
                                        <td>@Formato.Entero(Model.Filas.Select(f => (f.Sector, f.Hoja)).Distinct().Count()) hojas</td>
                                        <td>@Formato.Entero(Model.Filas.Count) KPI</td>
                                        <td class="num"></td>
                                        <td class="num"></td>
                                        <td class="num"></td>
                                        <td class="num"></td>
                                        <td></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    }
                    <p class="nota-ns">Las metas salen en % si todas las de la fila caben en ±150 %; si no (TMO, horas, notas de calidad…), con su cifra. «Sin peso» es un requisito o una llave: no puntúa.</p>
                </section>

                <section class="tarjeta">
                    <header class="tarjeta-cabecera">
                        <h2>Ficheros leídos</h2>
                        <span class="tarjeta-nota">de cada sector, la versión más reciente: carpeta VF, V2, V1 o precierre y, dentro, la marca VF, V3, V2 o V1 del nombre · la ruta, para abrirlo y validar</span>
                    </header>
                    <div class="tabla-contenedor alta">
                        <table class="ranking">
                            <thead>
                                <tr>
                                    <th scope="col"><button type="button" class="ordenar">Sector</button></th>
                                    <th scope="col"><button type="button" class="ordenar">Versión</button></th>
                                    <th scope="col"><button type="button" class="ordenar">Hoja leída</button></th>
                                    <th scope="col" class="num"><button type="button" class="ordenar">Bloques</button></th>
                                    <th scope="col"><button type="button" class="ordenar">Estado</button></th>
                                    <th scope="col"><button type="button" class="ordenar">Ruta</button></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var x in Model.Archivos)
                                {
                                    var agentes = Agentes(x);
                                    var ruta = Model.RutaVisible(x.Archivo.Ruta);
                                    var (chip, texto) = x.Estado switch
                                    {
                                        "ok" when agentes == 0 => ("", "Sin agentes"),
                                        "ok" => ("chip-bueno", "Leído"),
                                        "sin-bloques" => ("chip-atencion", "Sin bloques"),
                                        "xlsb" => ("chip-critico", ".xlsb"),
                                        _ => ("chip-critico", "Error"),
                                    };
                                    <tr title="@ruta · modificado el @Formato.FechaHora(x.Archivo.Modificado) · @x.Archivo.Versiones @(x.Archivo.Versiones == 1 ? "versión" : "versiones") en el mes">
                                        <td class="celda-nombre" data-valor="@x.Archivo.Sector"><div class="nombre-fila"><span class="nombre-texto">@x.Archivo.Sector</span>@if (x.Archivo.Responsable.Length > 0)
                                            {
                                                <span class="pastilla-dato">@x.Archivo.Responsable</span>
                                            }</div></td>
                                        <td data-valor="@x.Archivo.Version">@x.Archivo.Version</td>
                                        <td data-valor="@Model.HojasLeidas(x)">@Model.HojasLeidas(x)</td>
                                        <td class="num" data-valor="@agentes">@agentes</td>
                                        <td data-valor="@texto"><span class="chip @chip">@texto</span></td>
                                        <td class="celda-ruta" data-valor="@ruta"><span class="ruta-texto">@x.Archivo.RutaRelativa</span> <button type="button" class="enlace" data-copiar="@ruta" title="Copiar @ruta">@Iconos.Svg("copiar") Copiar</button></td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr class="total">
                                    <td>TOTAL</td>
                                    <td>@Formato.Entero(Model.Archivos.Count) ficheros</td>
                                    <td></td>
                                    <td class="num">@Formato.Entero(Model.Archivos.Sum(Agentes))</td>
                                    <td>@Formato.Entero(conPesos) leídos</td>
                                    <td></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </section>

                <section class="tarjeta">
                    <header class="tarjeta-cabecera">
                        <h2>Validación</h2>
                        <span class="tarjeta-nota">que los pesos sumen 100 %, que cada KPI con peso tenga sus metas y que vayan en un solo sentido</span>
                    </header>
                    <ul class="comprobaciones-ns">
                        @foreach (var c in Model.Comprobaciones)
                        {
                            <li>@FormatoNoSolucion.ChipComprobacion(c.Correcto) <span><b>@c.Sector</b>: @c.Texto</span></li>
                        }
                    </ul>
                </section>
            </main>
        </div>
    }
    </div>
</div>
