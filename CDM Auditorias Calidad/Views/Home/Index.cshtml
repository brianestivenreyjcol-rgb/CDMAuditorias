@model PortadaModelo
@* Portada: dos tarjetas de grupo con el mismo molde que las de informe (lo pidió el usuario el 13-10-2026). «General»
   (/informes) lleva Auditorías, CDM No solución y GAIA Formación y está abierto; «Personal» (/personal) lleva por sector y
   Pesos y metas y pide contraseña (CLAVE_PERSONAL del .env; vale 12 h en cada navegador). El color de marca solo queda en
   el logotipo: la página va en marino y grises (data-marca="portada"). *@
@{
    ViewData["Title"] = "Menú";
    ViewData["Marca"] = "portada";

    var generalTexto = Model.GeneralConDatos switch
    {
        3 => "Datos cargados en los 3 informes",
        0 => "Datos sin cargar",
        var n => "Datos cargados en " + n + " de 3 informes",
    };
}
<partial name="_Cabecera" model="new CabeceraModelo()" />

<main class="portada">
    <section class="portada-hero">
        <div class="portada-marca" aria-hidden="true">
            @Iconos.Logotipo()
            <span class="portada-marca-texto"><b>CDM</b><span>Auditorías</span></span>
        </div>
        <div class="portada-hero-texto">
            <p class="portada-kicker">2 grupos · 5 informes</p>
            <h1 class="portada-titulo">Informes de calidad y formación</h1>
            <p class="portada-lema">General está abierto para todos; Personal pide contraseña.</p>
        </div>
    </section>

    <nav class="modulos grupos" aria-label="Grupos de informes">
        <a class="modulo" href="/informes">
            <div class="modulo-cab">
                <span class="modulo-icono">@Iconos.Svg("cuadricula")</span>
                <span class="etiqueta">3 informes</span>
            </div>
            <h2><small>CDM · Para todos</small>General</h2>
            <p class="descripcion">Auditorías de calidad (con Formación &amp; Calidad y T0), CDM No solución de Call Bogotá y GAIA Formación de los agentes nuevos.</p>
            <div class="modulo-pie">
                <div class="modulo-pie-texto">
                    <span class="modulo-estado@(Model.GeneralConDatos == 3 ? " ok" : "")">@generalTexto</span>
                    <span class="detalle">Auditorías · CDM No solución · GAIA Formación</span>
                </div>
                <span class="flecha">@Iconos.Svg("flecha")</span>
            </div>
        </a>
        <a class="modulo" href="/personal">
            <div class="modulo-cab">
                <span class="modulo-icono">@Iconos.Svg(Model.PersonalAbierto ? "candado-abierto" : "candado")</span>
                <span class="etiqueta">2 informes</span>
            </div>
            <h2><small>CDM · Con contraseña</small>Personal</h2>
            <p class="descripcion">Rellamada y No solución de cada sector de Bogotá, y los pesos y metas de los Excel de ranking de incentivos.</p>
            <div class="modulo-pie">
                <div class="modulo-pie-texto">
                    @if (Model.PersonalAbierto)
                    {
                        <span class="modulo-estado ok">Abierto en este navegador</span>
                        <span class="detalle">La contraseña se vuelve a pedir a las 12 h</span>
                    }
                    else if (!Model.PersonalConfigurado)
                    {
                        <span class="modulo-estado">Cerrado</span>
                        <span class="detalle">Falta configurar la contraseña en el servidor</span>
                    }
                    else
                    {
                        <span class="modulo-estado">Pide contraseña</span>
                        <span class="detalle">Se escribe una vez y vale 12 h en este navegador</span>
                    }
                </div>
                <span class="flecha">@Iconos.Svg("flecha")</span>
            </div>
        </a>
    </nav>
</main>
