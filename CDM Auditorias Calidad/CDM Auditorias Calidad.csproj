<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CDM_Auditorias_Calidad</RootNamespace>
    <!-- Se arranca con dotnet: la política del equipo bloquea ejecutables sin firma en carpetas de usuario. -->
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- La consulta del Power BI viaja con la aplicación y se lee al arrancar. -->
    <None Remove="Consultas\**" />
    <Content Include="Consultas\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CDM Auditorias Calidad.Tests" />
  </ItemGroup>

</Project>
