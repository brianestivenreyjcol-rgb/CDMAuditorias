table Medidas
	lineageTag: f14ae041-cfae-43f7-9a09-de7a4d75ef9b

	measure 'Auditorías del Día' =
			
			CALCULATE(
			    [Total Auditorías],
			    Calendario[Fecha] = MAX(Calendario[Fecha])
			)
		formatString: 0
		lineageTag: 594c0668-151e-436a-aa93-30ecfa685582

	measure 'Auditorías Ayer' =
			
			CALCULATE(
			    [Total Auditorías],
			    Calendario[Fecha] = MAX(Calendario[Fecha]) - 1
			)
		formatString: 0
		lineageTag: 0ca28a87-cb98-4fb3-b549-aec0fd942333

	measure 'Auditorías de la Semana' =
			
			CALCULATE(
			    [Total Auditorías],
			    DATESBETWEEN(
			        Calendario[Fecha],
			        MAX(Calendario[Fecha]) - WEEKDAY(MAX(Calendario[Fecha]), 2) + 1,
			        MAX(Calendario[Fecha])
			    )
			)
		formatString: 0
		lineageTag: 90c0f921-f8ed-40c5-9728-221161c0cd20

	measure 'Auditorías Semana Anterior' =
			
			CALCULATE(
			    [Auditorías de la Semana],
			    DATEADD(Calendario[Fecha], -7, DAY)
			)
		formatString: 0
		lineageTag: 0b6a3125-f111-4e11-b6b3-fe4fc8b3e9c8

	measure 'Auditorías del Mes' =
			
			CALCULATE(
			    [Total Auditorías],
			    DATESMTD(Calendario[Fecha])
			)
		formatString: 0
		lineageTag: b370d300-0acb-4b37-9a4a-e366bdb84e38

	measure 'Auditorías Mes Anterior' =
			
			CALCULATE(
			    [Auditorías del Mes],
			    DATEADD(Calendario[Fecha], -1, MONTH)
			)
		formatString: 0
		lineageTag: 9d2436ef-025d-4eff-8263-59f63aec9ade

	measure 'Var % Semana vs Anterior' =
			
			DIVIDE([Auditorías de la Semana] - [Auditorías Semana Anterior], [Auditorías Semana Anterior])
		lineageTag: 5e5846f2-f3bb-42a1-9b8b-cd21ab24cff1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Var % Mes vs Anterior' =
			
			DIVIDE([Auditorías del Mes] - [Auditorías Mes Anterior], [Auditorías Mes Anterior])
		lineageTag: eb26601f-862b-4e83-89ae-828051cdac77

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Nota Promedio de Calidad' = AVERAGE(Auditorias[Respuesta])
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 1f80ec27-584a-4f19-a241-aa81422a2523

	measure 'Meta de Calidad' = 0.5   -- constante, para la línea punteada del gráfico
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: c69261d3-a883-4985-b2be-21d4dea2b4f3

	measure 'Agentes Auditados' = DISTINCTCOUNT(Auditorias[legajo])
		formatString: 0
		lineageTag: d556e0cc-1012-421f-9392-ab191af54de6

	measure 'Promedio Auditorías por Agente' =
			
			DIVIDE([Total Auditorías], [Agentes Auditados])
		lineageTag: 2dbb813d-9000-4d4c-a7e0-885df5dde241

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Var % Agentes vs Periodo Anterior' =
			
			DIVIDE(
			    [Agentes Auditados] - CALCULATE([Agentes Auditados], DATEADD(Calendario[Fecha], -1, MONTH)),
			    CALCULATE([Agentes Auditados], DATEADD(Calendario[Fecha], -1, MONTH))
			)
		lineageTag: f3bd153a-1292-442a-b12c-97c401d00963

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Tarjetas KPI' =
			
			VAR _totalAud = [Total Auditorías]
			VAR _varTotal = [Var % vs Periodo Anterior]
			VAR _colorTotal = IF(_varTotal >= 0,"#16A34A","#DC2626")
			VAR _flechaTotal = IF(_varTotal >= 0,"▲","▼")
			VAR _semana = [Auditorías de la Semana]
			VAR _varSemana = [Var % Semana vs Anterior]
			VAR _colorSemana = IF(_varSemana >= 0,"#16A34A","#DC2626")
			VAR _flechaSemana = IF(_varSemana >= 0,"▲","▼")
			VAR _mes = [Auditorías del Mes]
			VAR _varMes = [Var % Mes vs Anterior]
			VAR _colorMes = IF(_varMes >= 0,"#16A34A","#DC2626")
			VAR _flechaMes = IF(_varMes >= 0,"▲","▼")
			VAR _nota = [Nota Promedio de Calidad]
			VAR _varNota = [Var pp vs Periodo Anterior]
			VAR _colorNota = IF(_varNota >= 0,"#16A34A","#DC2626")
			VAR _flechaNota = IF(_varNota >= 0,"▲","▼")
			VAR _agentes = [Agentes Auditados]
			VAR _varAgentes = [Var % Agentes vs Periodo Anterior]
			VAR _colorAgentes = IF(_varAgentes >= 0,"#16A34A","#DC2626")
			VAR _flechaAgentes = IF(_varAgentes >= 0,"▲","▼")
			RETURN
			"<div style='display:flex;width:100%;height:157px;font-family:Segoe UI,sans-serif;box-sizing:border-box;align-items:stretch;'>" &
			"<div style='flex:1;height:157px;background:#FFFFFF;border:1px solid #D9D9D9;border-top:4px solid #FF6600;border-radius:10px;padding:10px 14px;margin:0 6px;box-shadow:0 2px 7px rgba(0,0,0,0.10);text-align:center;box-sizing:border-box;display:flex;flex-direction:column;justify-content:center;align-items:center;'>" &
			"<div style='font-size:13px;font-weight:600;color:#666666;letter-spacing:0.3px;line-height:18px;'>TOTAL AUDITORÍAS</div>" &
			"<div style='font-size:34px;font-weight:700;color:#292929;margin-top:4px;line-height:40px;'>"
			& FORMAT(_totalAud,"#,##0") &
			"</div>" &
			"<div style='font-size:12px;font-weight:600;color:" & _colorTotal & ";margin-top:7px;line-height:17px;'>"
			& _flechaTotal & " " & FORMAT(ABS(_varTotal),"0.0%") & " vs. período anterior</div>" &
			"</div>" &
			"<div style='flex:1;height:157px;background:#FFFFFF;border:1px solid #D9D9D9;border-top:4px solid #FF6600;border-radius:10px;padding:10px 14px;margin:0 6px;box-shadow:0 2px 7px rgba(0,0,0,0.10);text-align:center;box-sizing:border-box;display:flex;flex-direction:column;justify-content:center;align-items:center;'>" &
			"<div style='font-size:13px;font-weight:600;color:#666666;letter-spacing:0.3px;line-height:18px;'>AUDITORÍAS DE LA SEMANA</div>" &
			"<div style='font-size:34px;font-weight:700;color:#292929;margin-top:4px;line-height:40px;'>"
			& FORMAT(_semana,"#,##0") &
			"</div>" &
			"<div style='font-size:12px;font-weight:600;color:" & _colorSemana & ";margin-top:7px;line-height:17px;'>"
			& _flechaSemana & " " & FORMAT(ABS(_varSemana),"0.0%") & " vs. semana anterior</div>" &
			"</div>" &
			"<div style='flex:1;height:157px;background:#FFFFFF;border:1px solid #D9D9D9;border-top:4px solid #FF6600;border-radius:10px;padding:10px 14px;margin:0 6px;box-shadow:0 2px 7px rgba(0,0,0,0.10);text-align:center;box-sizing:border-box;display:flex;flex-direction:column;justify-content:center;align-items:center;'>" &
			"<div style='font-size:13px;font-weight:600;color:#666666;letter-spacing:0.3px;line-height:18px;'>AUDITORÍAS DEL MES</div>" &
			"<div style='font-size:34px;font-weight:700;color:#292929;margin-top:4px;line-height:40px;'>"
			& FORMAT(_mes,"#,##0") &
			"</div>" &
			"<div style='font-size:12px;font-weight:600;color:" & _colorMes & ";margin-top:7px;line-height:17px;'>"
			& _flechaMes & " " & FORMAT(ABS(_varMes),"0.0%") & " vs. mes anterior</div>" &
			"</div>" &
			"<div style='flex:1;height:157px;background:#FFFFFF;border:1px solid #D9D9D9;border-top:4px solid #2B2B2B;border-radius:10px;padding:10px 14px;margin:0 6px;box-shadow:0 2px 7px rgba(0,0,0,0.10);text-align:center;box-sizing:border-box;display:flex;flex-direction:column;justify-content:center;align-items:center;'>" &
			"<div style='font-size:13px;font-weight:600;color:#666666;letter-spacing:0.3px;line-height:18px;'>NOTA PROMEDIO DE CALIDAD</div>" &
			"<div style='font-size:34px;font-weight:700;color:#292929;margin-top:4px;line-height:40px;'>"
			& FORMAT(_nota,"0.0%") &
			"</div>" &
			"<div style='font-size:12px;font-weight:600;color:" & _colorNota & ";margin-top:7px;line-height:17px;'>"
			& _flechaNota & " " & FORMAT(ABS(_varNota),"0.0") & " pp vs. período anterior</div>" &
			"</div>" &
			"<div style='flex:1;height:157px;background:#FFFFFF;border:1px solid #D9D9D9;border-top:4px solid #2B2B2B;border-radius:10px;padding:10px 14px;margin:0 6px;box-shadow:0 2px 7px rgba(0,0,0,0.10);text-align:center;box-sizing:border-box;display:flex;flex-direction:column;justify-content:center;align-items:center;'>" &
			"<div style='font-size:13px;font-weight:600;color:#666666;letter-spacing:0.3px;line-height:18px;'>AGENTES AUDITADOS</div>" &
			"<div style='font-size:34px;font-weight:700;color:#292929;margin-top:4px;line-height:40px;'>"
			& FORMAT(_agentes,"#,##0") &
			"</div>" &
			"<div style='font-size:12px;font-weight:600;color:" & _colorAgentes & ";margin-top:7px;line-height:17px;'>"
			& _flechaAgentes & " " & FORMAT(ABS(_varAgentes),"0.0%") & " vs. período anterior</div>" &
			"</div>" &
			"</div>"
		lineageTag: 13f9644f-6b95-4766-ae3e-53c38adbd99b

	measure 'Auditorías Periodo Anterior' =
			
			CALCULATE(
			    [Total Auditorías],
			    DATEADD(Calendario[Fecha], -1, MONTH)   -- ajusta la granularidad según tu filtro de "Periodo"
			)
		formatString: 0
		lineageTag: 64448a39-16db-49b0-9949-f5c4bbcb0ec2

	measure 'Var % vs Periodo Anterior' =
			
			DIVIDE([Total Auditorías] - [Auditorías Periodo Anterior], [Auditorías Periodo Anterior])
		lineageTag: 19665666-5cba-47b2-ac5f-8f716e2936d6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Var pp vs Periodo Anterior' =
			
			([Nota Promedio de Calidad] - [Nota Promedio Periodo Anterior]) * 100
		lineageTag: ec1c5392-bca0-4b82-93ca-6f1e6bfa8ef3

	measure 'Nota Promedio Periodo Anterior' =
			
			CALCULATE(
			    [Nota Promedio de Calidad],
			    DATEADD(Calendario[Fecha], -1, MONTH)
			)
		lineageTag: ea80fb3d-66dd-4565-819a-bfb59dba50c7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Auditorías' = COUNTROWS(Auditorias)
		formatString: 0
		lineageTag: 40b5cf12-3953-4e8b-aef2-485109c7c1e4

	measure 'Titulo Encabezado General' =
			
			"<div style='font-family:Segoe UI, sans-serif; text-align:left;'>" &
			    "<div style='font-size:22px; font-weight:800; color:#000000; letter-spacing:0.3px;'>AUDITORÍAS | CONTROL Y CALIDAD</div>" &
			    "<div style='font-size:14px; font-weight:600; color:#000000; margin-top:2px;'>General</div>" &
			"</div>"
		lineageTag: e954052f-1885-4be8-b9c9-c5045c844af9

	measure 'Titulo Encabezado Formación' =
			
			"<div style='font-family:Segoe UI, sans-serif; text-align:left;'>" &
			    "<div style='font-size:22px; font-weight:800; color:#000000; letter-spacing:0.3px;'>AUDITORÍAS | CONTROL Y CALIDAD</div>" &
			    "<div style='font-size:14px; font-weight:600; color:#000000; margin-top:2px;'>Formación & Calidad</div>" &
			"</div>"
		lineageTag: 0baeb994-627f-416b-818b-158706d60af9

	measure 'Tarjeta Flip Agentes Nota' =
			
			VAR _agentes = [Agentes Auditados]
			VAR _nota    = [Nota Promedio de Calidad] * 100
			VAR _fNota   = FORMAT(_nota, "0.0")
			
			RETURN
			"
			<style>
			*{box-sizing:border-box;margin:0;padding:0;}
			body{
			  background:transparent;
			  font-family:'Segoe UI',system-ui,sans-serif;
			  display:flex;align-items:center;justify-content:center;
			}
			
			.card{
			  width:100%;
			  height:160px;
			  perspective:800px;
			  position:relative;
			}
			
			.card input[type=checkbox]{ display:none; }
			
			.flip-btn{
			  position:absolute;
			  inset:0;
			  z-index:10;
			  cursor:pointer;
			  border-radius:16px;
			}
			
			.inner{
			  width:100%;height:100%;
			  position:relative;
			  transform-style:preserve-3d;
			  transition:transform 0.7s cubic-bezier(0.4,0.05,0.2,1);
			}
			
			.card input:checked ~ .inner{
			  transform:rotateY(180deg);
			}
			
			.front,.back{
			  position:absolute;
			  inset:0;
			  border-radius:16px;
			  backface-visibility:hidden;
			  -webkit-backface-visibility:hidden;
			  display:flex;
			  flex-direction:column;
			  align-items:center;
			  justify-content:center;
			  gap:2px;
			  padding:16px;
			}
			
			.front{
			  background:linear-gradient(135deg, #667eea 0%, #764ba2 100%);
			  color:white;
			  box-shadow:0 8px 32px rgba(102,126,234,0.4);
			}
			
			.front .valor{
			  font-size:52px;
			  font-weight:900;
			  color:white;
			  letter-spacing:-0.02em;
			  text-shadow:0 2px 12px rgba(0,0,0,0.15);
			}
			
			.front .titulo{
			  font-size:14px;
			  font-weight:600;
			  letter-spacing:1.5px;
			  text-transform:uppercase;
			  opacity:0.9;
			  margin-bottom:4px;
			}
			
			.front .hint{
			  font-size:11px;
			  opacity:0.75;
			  margin-top:4px;
			}
			
			.back{
			  background:linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
			  color:white;
			  transform:rotateY(180deg);
			  box-shadow:0 8px 32px rgba(245,87,108,0.4);
			}
			
			.back .valor{
			  font-size:52px;
			  font-weight:900;
			  color:white;
			  letter-spacing:-0.02em;
			  text-shadow:0 2px 12px rgba(0,0,0,0.15);
			}
			
			.back .titulo{
			  font-size:14px;
			  font-weight:600;
			  letter-spacing:1.5px;
			  text-transform:uppercase;
			  opacity:0.9;
			  margin-bottom:4px;
			}
			
			.back .hint{
			  font-size:11px;
			  opacity:0.75;
			  margin-top:4px;
			}
			</style>
			
			<div class='card'>
			  <input type='checkbox' id='flipAgentesNota'>
			  <label for='flipAgentesNota' class='flip-btn'></label>
			  <div class='inner'>
			
			    <div class='front'>
			      <div class='titulo'>📊 AGENTES AUDITADOS</div>
			      <div class='valor'>" & FORMAT(_agentes, "#,##0") & "</div>
			      <div class='hint'>🔄 Clic para ver nota de calidad</div>
			    </div>
			
			    <div class='back'>
			      <div class='titulo'>⭐ NOTA DE CALIDAD</div>
			      <div class='valor'>" & _fNota & "%</div>
			      <div class='hint'>🔄 Clic para regresar</div>
			    </div>
			
			  </div>
			</div>
			"
		lineageTag: 410b639a-3f70-44f3-9646-4aff52c50ee9

	partition Medidas = m
		mode: import
		source =
				let
				    Origen = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Columna1 = _t]),
				    #"Tipo cambiado" = Table.TransformColumnTypes(Origen,{{"Columna1", type text}}),
				    #"Columnas quitadas" = Table.RemoveColumns(#"Tipo cambiado",{"Columna1"})
				in
				    #"Columnas quitadas"

	annotation PBI_ResultType = Table

