	column Trimestre
		lineageTag: d4f48d4b-4733-4ceb-b236-0ca0b10667fc
		summarizeBy: none
		isNameInferred
		sourceColumn: [Trimestre]

		annotation SummarizationSetBy = Automatic

	partition Calendario = calculated
		mode: import
		source =
				
				ADDCOLUMNS(
				    CALENDAR(MIN(Auditorias[Fecha]), MAX(Auditorias[Fecha])),
				    "Año", YEAR([Date]),
				    "NumMes", MONTH([Date]),
				    "Mes", FORMAT([Date], "MMM"),
				    "MesAño", FORMAT([Date], "MMM YYYY"),
				    "Día", DAY([Date]),
				    "DiaSemana", FORMAT([Date], "dddd"),
				    "NumDiaSemana", WEEKDAY([Date], 2),
				    "Semana", WEEKNUM([Date], 2),
				    "Trimestre", "T" & FORMAT([Date], "Q")
				)

	annotation PBI_Id = 383cd43ae0c84ff9b1c64fee4afc1698

